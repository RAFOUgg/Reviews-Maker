# Dependencies
node_modules/
*/node_modules/
client/node_modules/
server-new/node_modules/
package-lock.json
*/package-lock.json

# Environment variables
.env
.env.local
.env.production
.env.development
*.local
.env.save
.env.bak*

# Build outputs
client/dist/
client/build/
dist/
build/
dist.tar.gz

# Deploy scripts (local modifications)
deploy.sh
scripts/deploy-vps.sh

# Database & Uploads
db/*.sqlite
db/*.sqlite-shm
db/*.sqlite-wal
db/review_images/*
db/kyc_documents/*
# Médias attachés aux étapes de pipeline — mêmes raisons que `review_images` et `kyc_documents`
# juste au-dessus : ce sont des fichiers déposés à l'exécution, pas des sources. La règle manquait,
# et des uploads de test (11 fichiers .mp4/.mov/.mkv/.avi/.3gp le 2026-08-14) se retrouvaient donc
# candidats au commit. Les quelques fichiers déjà versionnés avant cette règle le restent — les
# retirer de l'index toucherait à des médias potentiellement réels.
db/pipeline_media/*
db/*.db
db/*.db-shm
db/*.db-wal
!db/review_images/.gitkeep
!db/kyc_documents/.gitkeep
db/backups/*
!db/backups/.gitkeep
*.bak

# SQLite DBs living under server-new (gap: only db/*.sqlite was covered above,
# so local/dev databases here were getting committed by accident)
server-new/prisma/*.sqlite
server-new/prisma/*.sqlite-journal
server-new/prisma/*.sqlite-shm
server-new/prisma/*.sqlite-wal
server-new/prisma/db/*.sqlite
server-new/db/*.sqlite

